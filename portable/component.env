NAME=ollama
SOURCE_REPO=  # provenance only: CultureReset/ollama@d63b702609c4300a2ca07be2bdb0adb9834725e5 (fork HEAD, NOT the live binary)
REQUIRES="ollama"
PORT=11434
HEALTH=http://127.0.0.1:11434/api/version
LIVE_VERSION=0.35.0
SETUP='v=$(ollama --version 2>&1 | grep -o "[0-9]*\.[0-9]*\.[0-9]*" | tail -1); [ "$v" = 0.35.0 ] || { echo "ollama $v != pinned 0.35.0; install with: curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION=0.35.0 sh" >&2; exit 3; }; ln -sf "$(command -v ollama)" "$2/ollama"'
UNITS=ollama.service
VERIFY_PATHS="@APPDIR@/ollama"
